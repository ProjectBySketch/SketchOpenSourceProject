// SketchOpenSourceProject daemon and CLI.
//
// One binary, three entry points (see main.cpp):
//   sketchd serve   - the daemon init starts at boot, listening on a unix socket
//   deb <verb>      - the same binary under its second name, the CLI
//   sketchd <verb>  - direct use, e.g. `su -c 'sketchd install x.deb'`
//
// Deliberately dependency-free: bionic, libstdc++ and nothing else, so it builds
// in any LineageOS 23 (Android 16) tree without pulling in libbase or liblog.

cc_binary {
    name: "sketchd",
    srcs: [
        "arch.cpp",
        "commands.cpp",
        "daemon.cpp",
        "main.cpp",
        "rootfs.cpp",
        "util.cpp",
    ],
    // sketch.h sits one level up, in vendor/sketch.
    local_include_dirs: [".."],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
    ],
    cpp_std: "c++20",
    system_ext_specific: true,
    // `deb` is the same binary: a symlink, so it is always executable and there
    // is only one copy of the code on the image.
    symlinks: ["deb"],
    init_rc: ["sketch.rc"],
    strip: {
        none: true,
    },
}
