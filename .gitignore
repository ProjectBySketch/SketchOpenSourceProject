# Build products of the userland step (large, regenerated by make-rootfs.sh)
.rootfs-build/
vendor/sketch/rootfs/prebuilt/*.tar.gz
vendor/sketch/rootfs/prebuilt/qemu-*-static

# scripts/run-local.sh: a compiled sketchd and a Debian userland, on this host
.local-run/

# scripts/build-dist.sh / make-live.sh: per-arch binaries, kernels, ISO staging
.build/
.media/

# Everything ./build.sh artifacts collects. Published as a GitHub release, never
# committed: images are gigabytes and git is not a download server.
dist/

# Local artefacts
*.deb
*.img
*.iso
out/
*.log
